# Copy this file to .env (same folder) and fill in your values. .env is git-ignored.
# Environment variables already set in your shell take precedence over this file.

# auto = live where configured, mock otherwise | mock = always offline | live = fail if not configured
NEXTAAA_LLM_MODE=auto

# --- Shared Azure resource (used by any role below that leaves endpoint/key empty) ---
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=

# --- 1. Generator: writes the concepts (recommended: GPT-6 Sol) ---
NEXTAAA_GEN_DEPLOYMENT=gpt-6-sol
# NEXTAAA_GEN_ENDPOINT=          # only if different from the shared resource
# NEXTAAA_GEN_API_KEY=
# NEXTAAA_GEN_API_VERSION=       # only for the classic api-version style; leave empty for the v1 API

# --- 2. LLM-as-predictor baseline (backtest only; recommended: gpt-oss-120b or gpt-5-mini) ---
NEXTAAA_JUDGE_DEPLOYMENT=gpt-oss-120b
# gpt-oss on Azure Foundry usually lives on a *.services.ai.azure.com resource:
# NEXTAAA_JUDGE_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com
# NEXTAAA_JUDGE_API_KEY=
# The model's knowledge cutoff (YYYY-MM). Only films released AFTER this year are tested.
NEXTAAA_JUDGE_CUTOFF=2024-06

# --- 3. Embeddings: plot similarity and text features (recommended: text-embedding-3-large) ---
NEXTAAA_EMBED_DEPLOYMENT=text-embedding-3-large
# NEXTAAA_EMBED_ENDPOINT=
# NEXTAAA_EMBED_API_KEY=
# Leave all EMBED settings empty to use the free local TF-IDF fallback instead.

# --- Any OpenAI-compatible server instead (e.g. a local vLLM/Ollama running gpt-oss) ---
# NEXTAAA_JUDGE_ENDPOINT=http://localhost:8000/v1
# NEXTAAA_JUDGE_API_KEY=anything
